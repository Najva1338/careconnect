```gitignore
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Django secrets and environment variables
.env
.env.*

# Local database
db.sqlite3
db.sqlite3-journal

# User-uploaded media
media/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test and coverage files
.coverage
htmlcov/
.pytest_cache/
```